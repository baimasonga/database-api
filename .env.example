# ---------------------------------------------------------------------------
# AVDP Integrated Data & Analytics Platform — environment configuration
# Copy to .env.local (never commit .env / .env.local)
# ---------------------------------------------------------------------------

# PostgreSQL connection for the modular monolith (Prisma).
DATABASE_URL="postgresql://avdp:avdp@127.0.0.1:5432/avdp?schema=public"

# Dashboard data mode: "mock" keeps the dashboard on bundled fixtures,
# "live" makes it consume /api/v1 (published + validated data only).
DATA_MODE="mock"

# Base URL used by the live dashboard provider for server-side fetches.
DASHBOARD_API_BASE_URL="http://127.0.0.1:3000"

# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-in-every-environment-min-32-chars-long"
SESSION_TTL_HOURS="12"

# Ingestion / upload controls
UPLOAD_STORAGE_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="26214400"
UPLOAD_ALLOWED_EXTENSIONS="csv,xlsx,xls"

# API rate limiting (per client, per window)
API_RATE_LIMIT="120"
API_RATE_LIMIT_WINDOW_SECONDS="60"

# Human-readable beneficiary reference format. {seq} is zero-padded.
BENEFICIARY_REF_FORMAT="AVDP-FRM-{seq}"
BENEFICIARY_REF_SEQ_WIDTH="8"

# Encryption key for integration secrets at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
INTEGRATION_SECRET_KEY=""
