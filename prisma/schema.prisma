  implementingPartner ImplementingPartner? @relation(fields: [implementingPartnerId], references: [id])
  reportingPeriod     ReportingPeriod?     @relation(fields: [reportingPeriodId], references: [id])

  @@index([districtId])
  @@index([assetType])
  @@index([reportingPeriodId])
  @@map("infrastructure_assets")
  @@schema("project_delivery")
}

// ===========================================================================
// PRODUCTION
// ===========================================================================

model Farm {
  id                String   @id @default(uuid()) @db.Uuid
  code              String?  @unique
  beneficiaryId     String?  @map("beneficiary_id") @db.Uuid
  districtId        String?  @map("district_id") @db.Uuid
  chiefdomId        String?  @map("chiefdom_id") @db.Uuid
  communityId       String?  @map("community_id") @db.Uuid
  totalAreaHa       Decimal? @map("total_area_ha") @db.Decimal(12, 4)
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)
  sourceImportJobId String?  @map("source_import_job_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  district    District?    @relation(fields: [districtId], references: [id])
  chiefdom    Chiefdom?    @relation(fields: [chiefdomId], references: [id])
  community   Community?   @relation(fields: [communityId], references: [id])
  plots       FarmPlot[]

  @@index([beneficiaryId])
  @@index([districtId])
  @@map("farms")
  @@schema("production")
}

model FarmPlot {
  id           String   @id @default(uuid()) @db.Uuid
  farmId       String   @map("farm_id") @db.Uuid
  valueChainId String?  @map("value_chain_id") @db.Uuid
  plotLabel    String?  @map("plot_label")
  areaHa       Decimal? @map("area_ha") @db.Decimal(12, 4)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  farm       Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  valueChain ValueChain?        @relation(fields: [valueChainId], references: [id])
  production ProductionRecord[]
  harvests   HarvestRecord[]

  @@index([farmId])
  @@index([valueChainId])
  @@map("farm_plots")
  @@schema("production")
}

model ProductionRecord {
  id                String   @id @default(uuid()) @db.Uuid
  beneficiaryId     String?  @map("beneficiary_id") @db.Uuid
  farmPlotId        String?  @map("farm_plot_id") @db.Uuid
  valueChainId      String   @map("value_chain_id") @db.Uuid
  reportingPeriodId String   @map("reporting_period_id") @db.Uuid
  season            String?
  cultivatedAreaHa  Decimal? @map("cultivated_area_ha") @db.Decimal(12, 4)
  quantity          Decimal? @db.Decimal(18, 4)
  unitOfMeasureId   String?  @map("unit_of_measure_id") @db.Uuid
  yieldPerHa        Decimal? @map("yield_per_ha") @db.Decimal(18, 4)
  districtId        String?  @map("district_id") @db.Uuid
  sourceImportJobId String?  @map("source_import_job_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  beneficiary     Beneficiary?    @relation(fields: [beneficiaryId], references: [id])
  farmPlot        FarmPlot?       @relation(fields: [farmPlotId], references: [id])
  valueChain      ValueChain      @relation(fields: [valueChainId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  unitOfMeasure   UnitOfMeasure?  @relation(fields: [unitOfMeasureId], references: [id])

  @@index([reportingPeriodId, valueChainId])
  @@index([districtId])
  @@index([beneficiaryId])
  @@map("production_records")
  @@schema("production")
}

model HarvestRecord {
  id                String    @id @default(uuid()) @db.Uuid
  beneficiaryId     String?   @map("beneficiary_id") @db.Uuid
  farmPlotId        String?   @map("farm_plot_id") @db.Uuid
  valueChainId      String    @map("value_chain_id") @db.Uuid
  reportingPeriodId String    @map("reporting_period_id") @db.Uuid
  harvestDate       DateTime? @map("harvest_date") @db.Date
  quantity          Decimal   @db.Decimal(18, 4)
  unitOfMeasureId   String?   @map("unit_of_measure_id") @db.Uuid
  postHarvestLoss   Decimal?  @map("post_harvest_loss") @db.Decimal(18, 4)
  districtId        String?   @map("district_id") @db.Uuid
  sourceImportJobId String?   @map("source_import_job_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  beneficiary     Beneficiary?    @relation(fields: [beneficiaryId], references: [id])
  farmPlot        FarmPlot?       @relation(fields: [farmPlotId], references: [id])
  valueChain      ValueChain      @relation(fields: [valueChainId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  unitOfMeasure   UnitOfMeasure?  @relation(fields: [unitOfMeasureId], references: [id])

  @@index([reportingPeriodId, valueChainId])
  @@map("harvest_records")
  @@schema("production")
}

model SalesRecord {
  id                String    @id @default(uuid()) @db.Uuid
  beneficiaryId     String?   @map("beneficiary_id") @db.Uuid
  valueChainId      String    @map("value_chain_id") @db.Uuid
  reportingPeriodId String    @map("reporting_period_id") @db.Uuid
  saleDate          DateTime? @map("sale_date") @db.Date
  quantity          Decimal   @db.Decimal(18, 4)
  unitOfMeasureId   String?   @map("unit_of_measure_id") @db.Uuid
  unitPrice         Decimal?  @map("unit_price") @db.Decimal(18, 4)
  totalValue        Decimal?  @map("total_value") @db.Decimal(18, 2)
  currency          String    @default("SLE")
  buyerType         String?   @map("buyer_type")
  districtId        String?   @map("district_id") @db.Uuid
  sourceImportJobId String?   @map("source_import_job_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  beneficiary     Beneficiary?    @relation(fields: [beneficiaryId], references: [id])
  valueChain      ValueChain      @relation(fields: [valueChainId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  unitOfMeasure   UnitOfMeasure?  @relation(fields: [unitOfMeasureId], references: [id])

  @@index([reportingPeriodId, valueChainId])
  @@map("sales_records")
  @@schema("production")
}

// ===========================================================================
// MONITORING — indicator registry, targets, observations
// ===========================================================================

enum ResultLevel {
  impact
  outcome
  output
  activity
  input

  @@schema("monitoring")
}

model Indicator {
  id                  String          @id @default(uuid()) @db.Uuid
  code                String          @unique
  name                String
  shortName           String?         @map("short_name")
  definition          String?
  description         String?
  unit                String?
  resultLevel         ResultLevel     @default(output) @map("result_level")
  calculationMethod   String?         @map("calculation_method")
  /// Declarative calculation reference resolved by the analytics layer.
  calculationRef      String?         @map("calculation_ref")
  calculationVersion  Int             @default(1) @map("calculation_version")
  frequency           UpdateFrequency @default(quarterly)
  responsibleUnit     String?         @map("responsible_unit")
  primaryDataSourceId String?         @map("primary_data_source_id") @db.Uuid
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  createdBy           String?         @map("created_by") @db.Uuid
  updatedBy           String?         @map("updated_by") @db.Uuid

  primaryDataSource DataSource?               @relation(fields: [primaryDataSourceId], references: [id])
  disaggregations   IndicatorDisaggregation[]
  targets           IndicatorTarget[]
  observations      IndicatorObservation[]

  @@index([resultLevel])
  @@index([isActive])
  @@map("indicators")
  @@schema("monitoring")
}

enum DisaggregationDimension {
  sex
  age_group
  district
  chiefdom
  value_chain
  reporting_period
  beneficiary_type

  @@schema("monitoring")
}

model IndicatorDisaggregation {
  id          String                  @id @default(uuid()) @db.Uuid
  indicatorId String                  @map("indicator_id") @db.Uuid
  dimension   DisaggregationDimension
  isRequired  Boolean                 @default(false) @map("is_required")
  createdAt   DateTime                @default(now()) @map("created_at")

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, dimension])
  @@map("indicator_disaggregations")
  @@schema("monitoring")
}

model IndicatorTarget {
  id                String   @id @default(uuid()) @db.Uuid
  indicatorId       String   @map("indicator_id") @db.Uuid
  reportingPeriodId String?  @map("reporting_period_id") @db.Uuid
  fiscalYear        Int?     @map("fiscal_year")
  districtId        String?  @map("district_id") @db.Uuid
  valueChainId      String?  @map("value_chain_id") @db.Uuid
  targetValue       Decimal  @map("target_value") @db.Decimal(18, 4)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid

  indicator       Indicator        @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])
  district        District?        @relation(fields: [districtId], references: [id])
  valueChain      ValueChain?      @relation(fields: [valueChainId], references: [id])

  @@unique([indicatorId, reportingPeriodId, districtId, valueChainId])
  @@index([indicatorId])
  @@map("indicator_targets")
  @@schema("monitoring")
}

/// Manually reported or externally supplied indicator values. Values derived
/// from published AVDP data are computed in the analytics layer instead.
model IndicatorObservation {
  id                  String   @id @default(uuid()) @db.Uuid
  indicatorId         String   @map("indicator_id") @db.Uuid
  reportingPeriodId   String   @map("reporting_period_id") @db.Uuid
  districtId          String?  @map("district_id") @db.Uuid
  valueChainId        String?  @map("value_chain_id") @db.Uuid
  sex                 String?
  ageGroup            String?  @map("age_group")
  value               Decimal  @db.Decimal(18, 4)
  calculationVersion  Int      @default(1) @map("calculation_version")
  publicationRecordId String?  @map("publication_record_id") @db.Uuid
  sourceImportJobId   String?  @map("source_import_job_id") @db.Uuid
  observedAt          DateTime @default(now()) @map("observed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid

  indicator       Indicator       @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  district        District?       @relation(fields: [districtId], references: [id])
  valueChain      ValueChain?     @relation(fields: [valueChainId], references: [id])

  @@index([indicatorId, reportingPeriodId])
  @@index([districtId])
  @@map("indicator_observations")
  @@schema("monitoring")
}

// ===========================================================================
// ANALYTICS — refresh bookkeeping for the published-data views
// ===========================================================================

model AnalyticsRefreshLog {
  id           String    @id @default(uuid()) @db.Uuid
  viewName     String    @map("view_name")
  status       String    @default("running")
  trigger      String    @default("manual")
  rowCount     Int?      @map("row_count")
  durationMs   Int?      @map("duration_ms")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  triggeredBy  String?   @map("triggered_by") @db.Uuid

  @@index([viewName, startedAt])
  @@map("analytics_refresh_log")
  @@schema("analytics")
}
