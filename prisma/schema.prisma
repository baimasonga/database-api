  beneficiaryId     String?   @map("beneficiary_id") @db.Uuid
  farmerGroupId     String?   @map("farmer_group_id") @db.Uuid
  reportingPeriodId String?   @map("reporting_period_id") @db.Uuid
  equipmentType     String    @map("equipment_type")
  serialNumber      String?   @map("serial_number")
  quantity          Int       @default(1)
  distributedOn     DateTime? @map("distributed_on") @db.Date
  districtId        String?   @map("district_id") @db.Uuid
  sourceImportJobId String?   @map("source_import_job_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

