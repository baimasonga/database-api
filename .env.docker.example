# Copy to .env beside docker-compose.yml. Never commit the result.
POSTGRES_USER=avdp
POSTGRES_DB=avdp

# openssl rand -base64 32
POSTGRES_PASSWORD=

# openssl rand -base64 48
AUTH_SECRET=

# openssl rand -base64 32  (required before integrations with credentials can be saved)
INTEGRATION_SECRET_KEY=

# Keep as "mock" until real AVDP datasets are approved and published.
DATA_MODE=mock

# The public origin the dashboard's live provider fetches from.
DASHBOARD_API_BASE_URL=https://avdp.example.gov.sl
